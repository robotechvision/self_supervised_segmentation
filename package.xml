<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>stego</name>
  <version>0.0.1</version>
  <description>
    Self-supervised semantic segmentation based on STEGO, refactored for Wild
    Visual Navigation, which uses it for both its STEGO features and its DINO
    backbones.

    This manifest exists so the library can be built in a ROS 2 workspace with
    colcon instead of having to be pip installed separately. There is no node
    here; the package installs the Python library and its model configuration.
  </description>
  <maintainer email="vargovcik@robotechvision.com">Matej Vargovcik</maintainer>
  <author>Piotr Libera</author>
  <author>Jonas Frey</author>
  <author>Matias Mattamala</author>
  <license>MIT</license>
  <url type="website">https://github.com/leggedrobotics/self_supervised_segmentation</url>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3_kornia</exec_depend>
  <exec_depend>python3_omegaconf</exec_depend>
  <exec_depend>python3_torchmetrics</exec_depend>
  <exec_depend>python3_pytorch_lightning</exec_depend>
  <exec_depend>python3_pydensecrf</exec_depend>
  <exec_depend>python3_wandb</exec_depend>
  <!-- Not available through rosdep, install with pip: torch, torchvision, kornia,
       omegaconf, pytorch_lightning, torchmetrics, pydensecrf, wandb. A plain
       `pip install -e .` on this repository pulls them all in; colcon installs
       none of them, it only expects them to be importable. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
